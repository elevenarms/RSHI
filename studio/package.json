{
  "name": "@spotless/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Live visualizer of the self-improving crew (Vite, vanilla TypeScript, SVG and canvas)",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fake": "tsx scripts/fake-run.ts",
    "shots": "vite build && tsx scripts/shots.ts"
  },
  "devDependencies": {
    "@spotless/crew": "workspace:*",
    "puppeteer-core": "24.43.1",
    "vite": "8.3.4"
  }
}
