{
  "name": "@spotless/crew",
  "version": "0.1.0",
  "private": true,
  "description": "A self-improving agent team on Crusoe Managed Inference that plays Spotless, learns from its own history and keeps only the changes that measurably help",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "crew": "tsx src/cli.ts"
  },
  "dependencies": {
    "@spotless/bench": "workspace:*",
    "@spotless/core": "workspace:*",
    "@spotless/levels": "workspace:*",
    "@spotless/server": "workspace:*",
    "@spotless/session": "workspace:*",
    "@spotless/catalogue": "workspace:*"
  }
}
