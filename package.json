{
  "name": "rshi",
  "version": "0.1.0",
  "private": true,
  "description": "RSHI: a self-improving agent team (crew) and its live visualizer (studio), built on DishwasherBench (upstream/DishwasherBench, a git submodule)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elevenarms/RSHI.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "pnpm --filter @spotless/crew --filter @spotless/studio run typecheck",
    "test": "pnpm --filter @spotless/crew --filter @spotless/studio run test",
    "build:web": "pnpm --filter @spotless/web build",
    "build:studio": "pnpm --filter @spotless/studio build",
    "crew": "pnpm --filter @spotless/crew crew",
    "provenance": "bash scripts/provenance.sh > PROVENANCE.md",
    "sync": "bash scripts/sync-from-monorepo.sh"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
